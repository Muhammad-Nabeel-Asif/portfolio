---
import { getProfile } from '../lib/site';

const profile = await getProfile();
---

<footer class="foot">
  <div class="wrap foot-inner">
    <p>{profile.name}. {profile.location}.</p>
    <p>
      Set in Atkinson Hyperlegible Next and Sofia Sans Extra Condensed. Built with Astro{
        profile.repository ? (
          <>
            , <a href={profile.repository}>source on GitHub</a>
          </>
        ) : null
      }.
    </p>
  </div>
</footer>

<style>
  .foot {
    border-top: var(--line) solid var(--ink);
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .foot-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    padding-block: 1.5rem;
  }
</style>
